# ─────────────────────────────────────────────────────────────────────────────
# ATSentra Backend — Environment Variables
# Copy this file to .env and fill in your actual values.
# ─────────────────────────────────────────────────────────────────────────────

# ── Server ────────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── Database ──────────────────────────────────────────────────────────────────
MONGO_URI=mongodb://127.0.0.1:27017/ai_ats

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_ACCESS_SECRET=your_super_secret_access_key_change_me
JWT_REFRESH_SECRET=your_super_secret_refresh_key_change_me
ACCESS_TOKEN_EXPIREY=15m
REFRESH_TOKEN_EXPIREY=7d

# ── CORS ──────────────────────────────────────────────────────────────────────
CLIENT_ORIGIN=http://localhost:5173

# ── AI / Gemini ───────────────────────────────────────────────────────────────
# Required if you use the Gemini-powered ATS analysis feature
GEMINI_API_KEY=your_google_gemini_api_key

# ── Uploads ───────────────────────────────────────────────────────────────────
UPLOAD_DIR=uploads
